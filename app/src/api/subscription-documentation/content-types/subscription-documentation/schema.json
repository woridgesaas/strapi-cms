{
  "kind": "collectionType",
  "collectionName": "subscription_documentations",
  "info": {
    "singularName": "subscription-documentation",
    "pluralName": "subscription-documentations",
    "displayName": "SubscriptionDocumentation"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
