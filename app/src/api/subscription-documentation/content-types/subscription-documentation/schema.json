      "type": "enumeration",
      "enum": [
        "BASIC",
        "PRO",
        "PREMIUM"
      ]
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "blocks"
    },
    "features": {
      "type": "blocks"
    },
    "advantages": {
      "type": "blocks"
    },
    "target": {
      "type": "string"
    },
    "durationOptions": {
      "type": "string",
      "default": "1 mois / 3 mois / 6 mois / 1 an"
    },
    "isPublishedToPublic": {
      "type": "boolean"
    }
  }
}
